# ==============================================================================
# LLM Provider Configuration (Choose one provider: anthropic, openai, vertex, or ollama)
# ==============================================================================
LLM_PROVIDER="vertex"
# Unified model identifier across all providers.
# If empty, automatically falls back to the provider's default best-fit:
# - anthropic: claude-sonnet-5
# - openai:    gpt-5, o3-mini
# - vertex:    gemini-3.8-flash, gemini-3.7-flash
# - ollama:    qwen3.8:27b, qwen3.8:72b
LLM_MODEL_NAME=""

# Option A: Anthropic (Recommended for autonomous navigation)
ANTHROPIC_API_KEY="" # Format: sk-ant-...

# Option B: OpenAI
OPENAI_API_KEY="" # Format: sk-...

# Option C: Google Cloud Vertex AI
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account-key.json"

# Option D: Ollama (Local & Free; experimental for function-calling models >= 14B)
OLLAMA_HOST="http://localhost:11434"

# ==============================================================================
# LLM Safety Ceilings & Financial Kill-Switches
# ==============================================================================
# Maximum allowed USD cost per task before immediate abort (kill-switch)
MAX_TASK_COST_USD=1.50
# Maximum LLM navigation reasoning steps before automatic task completion
MAX_TASK_LLM_STEPS=30

# ==============================================================================
# Backend Server & Security Invariants
# ==============================================================================
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
ALLOWED_HOSTS="127.0.0.1,localhost,testserver"
API_TOKEN="your-secure-random-token-here"
ALLOW_ROUTABLE_NETWORK=false # Set to true only if deploying behind secure TLS / reverse proxy (e.g. AWS Fargate)
ALLOWED_EXTENSION_ID="ckfcbipidpedpdlijgmhmoapjlnfiaog" # Pinned ID derived from the fixed public key in extension/manifest.json

# ==============================================================================
# Langfuse Observability (Optional: leave empty for offline mode without telemetry)
# ==============================================================================
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST=""
